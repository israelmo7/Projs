# =============================================================================
# Wake Word Detection Project - .gitignore
# Filters out generated files, models, and temporary data
# =============================================================================

# =============================================================================
# Generated TTS Audio Files
# These are large binary files that can be regenerated from scripts
# =============================================================================
/raw_audio/
/*.mp3
*.wav

# =============================================================================
# Trained Machine Learning Models
# These can be regenerated by re-running the training pipeline
# =============================================================================
# TensorFlow/Keras models
/models/*.h5

# TensorFlow Lite models
/models/*.tflite

# =============================================================================
# Preprocessed Feature Data
# Large NumPy arrays that can be regenerated
# =============================================================================
/prepared_features/

# =============================================================================
# Dataset Training Subdirectories
# Organized splits that can be regenerated from source data
# =============================================================================
/dataset/train/positive/
/dataset/train/negative/

# =============================================================================
# Cache and Temporary Files
# =============================================================================
# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (if created in this folder)
venv/
.venv/
env/
.env

# IDE specific (keep in IDE, don't commit)
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# =============================================================================
# Notes
# =============================================================================
# - The models directory keeps the C header (model_data.h) as it's needed for
#   deployment, but the actual model files (.h5, .tflite) are filtered out
# - TTS audio files can be regenerated by running generate_tts.py
# - Feature files can be regenerated by running extract_features.py
# - Training models can be regenerated by running train_model.py
